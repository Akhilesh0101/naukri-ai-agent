# ---- Database (REQUIRED: set your PostgreSQL password) ----
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Your machine runs PostgreSQL 15 (port 5432) and 17 (port 5433).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/naukri_agent

# ---- App ----
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ---- Frontend origin for CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Matching defaults (also editable in the dashboard) ----
MIN_MATCH_SCORE=75
WEIGHT_SKILLS=0.45
WEIGHT_ROLE=0.25
WEIGHT_EXPERIENCE=0.20
WEIGHT_LOCATION=0.10

# ---- Optional local semantic similarity (free, fully local) ----
# Set true to blend resume<->job embedding similarity into the match score.
ENABLE_SEMANTIC=false
# Provider: "ollama" (recommended; uses your local Ollama, no big download)
#        or "sentence_transformers" (downloads a model on first use, needs torch).
EMBEDDING_PROVIDER=ollama
# How much the semantic signal counts (0..1). 0.20 = 20%.
SEMANTIC_BLEND=0.20
# Model for the Ollama provider (you already have nomic-embed-text).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Model for the sentence_transformers provider.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Optional local LLM via Ollama (free) ----
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest

# ---- Scheduling ----
ENABLE_SCHEDULER=true
POLL_INTERVAL_MINUTES=30

# ---- Application submission (keep false until an authorized provider is verified) ----
AUTO_SUBMIT_ENABLED=false

# ---- Outbound fetch safety (URL search) ----
ALLOWED_FETCH_DOMAINS=naukri.com,www.naukri.com
FETCH_TIMEOUT_SECONDS=15
